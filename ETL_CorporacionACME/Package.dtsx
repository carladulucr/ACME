                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT TiempoId, Fecha, Anio, MesId, Mes, TrimestreId, Trimestre, DiaId, Dia
FROM dbo.dimFecha</property>
                <property
                  dataType="System.String"
                  description="Especifica una instrucción SQL que usa parámetros para generar la tabla de búsqueda."
                  expressionType="Notify"
                  name="SqlCommandParam"
