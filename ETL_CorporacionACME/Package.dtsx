                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
  p.id_producto,
  p.descripcion,
  p.precio_unitario,
  c.nombre AS categoria,
  m.nombre AS marca,
  pr.nombre AS proveedor,
  a.ubicacion AS ubicacion_almacen,
  TRY_CONVERT(date, p.fecha_vencimiento) AS fecha_vencimiento
FROM dbo.Producto p
LEFT JOIN dbo.Categoria_Producto c ON p.id_categoria = c.id_categoria
LEFT JOIN dbo.Marca m ON p.id_marca = m.id_marca
LEFT JOIN dbo.Proveedor pr ON p.id_proveedor = pr.id_proveedor
LEFT JOIN dbo.Almacen a ON p.id_almacen = a.id_almacen;</property>
