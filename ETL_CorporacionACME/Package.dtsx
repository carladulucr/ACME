                          dataType="System.String"
                          description="Expresión descriptiva de columna derivada"
                          expressionType="Notify"
                          name="FriendlyExpression">(((DATEPART("Dw",(DT_DBTIMESTAMP)fecha_emision) + 5) % 7) + 1) == 1 ? "LUNES" : (((DATEPART("Dw",(DT_DBTIMESTAMP)fecha_emision) + 5) % 7) + 1) == 2 ? "MARTES" : (((DATEPART("Dw",(DT_DBTIMESTAMP)fecha_emision) + 5) % 7) + 1) == 3 ? "MIERCOLES" : (((DATEPART("Dw",(DT_DBTIMESTAMP)fecha_emision) + 5) % 7) + 1) == 4 ? "JUEVES" : (((DATEPART("Dw",(DT_DBTIMESTAMP)fecha_emision) + 5) % 7) + 1) == 5 ? "VIERNES" : (((DATEPART("Dw",(DT_DBTIMESTAMP)fecha_emision) + 5) % 7) + 1) == 6 ? "SABADO" : "DOMINGO"</property>
